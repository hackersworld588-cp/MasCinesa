// CineMate Prisma Database Schema
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("user") // 'user', 'admin', 'moderator'
  avatar       String?
  bio          String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  watchHistory    WatchHistory[]
  watchlists      Watchlist[]
  ratings         Rating[]
  reviews         Review[]
  reviewVotes     ReviewVote[]
  userPreference  UserPreference?
  conversations   Conversation[]
  recommendations Recommendation[]
  reports         Report[]

  @@map("users")
}

model Movie {
  id                 String    @id @default(uuid())
  tmdbId             Int?      @unique
  imdbId             String?
  title              String
  originalTitle      String?
  tagline            String?
  overview           String
  releaseDate        String?
  releaseYear        Int?
  runtime            Int?      // in minutes
  posterUrl          String
  backdropUrl        String
  trailerUrl         String?
  trailerKey         String?
  fullMovieKey       String?
  isFreeWatch        Boolean   @default(false)
  voteAverage        Float     @default(0.0)
  voteCount          Int       @default(0)
  popularity         Float     @default(0.0)
  language           String    @default("en")
  originCountry      String    @default("US")
  budget             BigInt?   @default(0)
  revenue            BigInt?   @default(0)
  streamingPlatforms String    @default("[]") // JSON string of platform names
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  movieGenres     MovieGenre[]
  movieCast       MovieCast[]
  movieDirectors  MovieDirector[]
  watchHistory    WatchHistory[]
  watchlistMovies WatchlistMovie[]
  ratings         Rating[]
  reviews         Review[]
  recommendations Recommendation[]

  @@map("movies")
}

model Genre {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  movieGenres MovieGenre[]

  @@map("genres")
}

model Actor {
  id               String  @id @default(uuid())
  tmdbId           Int?    @unique
  name             String
  profileUrl       String?
  characterDefault String?
  popularity       Float   @default(0.0)

  movieCast MovieCast[]

  @@map("actors")
}

model Director {
  id         String  @id @default(uuid())
  tmdbId     Int?    @unique
  name       String
  profileUrl String?
  popularity Float   @default(0.0)

  movieDirectors MovieDirector[]

  @@map("directors")
}

model MovieGenre {
  movieId String
  genreId String

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
  @@map("movie_genres")
}

model MovieCast {
  id            String @id @default(uuid())
  movieId       String
  actorId       String
  characterName String
  orderIndex    Int    @default(0)

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@map("movie_cast")
}

model MovieDirector {
  movieId    String
  directorId String

  movie    Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  director Director @relation(fields: [directorId], references: [id], onDelete: Cascade)

  @@id([movieId, directorId])
  @@map("movie_directors")
}

model WatchHistory {
  id            String   @id @default(uuid())
  userId        String
  movieId       String
  watchedAt     DateTime @default(now())
  watchDuration Int      @default(0)
  completed     Boolean  @default(true)
  device        String   @default("web")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@map("watch_history")
}

model Watchlist {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  isPrivate   Boolean  @default(false)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  movies WatchlistMovie[]

  @@map("watchlists")
}

model WatchlistMovie {
  id            String   @id @default(uuid())
  watchlistId   String
  movieId       String
  addedAt       DateTime @default(now())
  personalNotes String?
  userRating    Float?
  isWatched     Boolean  @default(false)

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  movie     Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, movieId])
  @@map("watchlist_movies")
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  movieId   String
  score     Int      // 1 to 10
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("ratings")
}

model Review {
  id                 String   @id @default(uuid())
  userId             String
  movieId            String
  rating             Int?     // 1 to 10
  title              String?
  content            String
  containsSpoilers   Boolean  @default(false)
  helpfulUpvotes     Int      @default(0)
  helpfulDownvotes   Int      @default(0)
  status             String   @default("approved") // 'pending', 'approved', 'flagged', 'removed'
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie       Movie        @relation(fields: [movieId], references: [id], onDelete: Cascade)
  reviewVotes ReviewVote[]
  reports     Report[]

  @@map("reviews")
}

model ReviewVote {
  id        String   @id @default(uuid())
  userId    String
  reviewId  String
  voteType  String   // 'UP' or 'DOWN'
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@map("review_votes")
}

model UserPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  favoriteGenres     String   @default("[]") // JSON array string
  favoriteActors     String   @default("[]") // JSON array string
  favoriteDirectors  String   @default("[]") // JSON array string
  preferredLanguages String   @default("[\"en\", \"hi\"]") // JSON array
  maxDuration        Int      @default(180)
  tasteWeights       String   @default("{}") // JSON key-value of genre percentages
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  title     String    @default("New Chat")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  sender         String   // 'user', 'assistant', 'system'
  content        String
  metadata       String   @default("{}") // JSON string containing movie recommendations
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Recommendation {
  id          String   @id @default(uuid())
  userId      String
  movieId     String
  score       Float    // 0.0 to 1.0
  engine      String   @default("hybrid") // 'content', 'collaborative', 'ai_semantic', 'hybrid'
  explanation String
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@map("recommendations")
}

model Report {
  id         String   @id @default(uuid())
  reporterId String?
  reviewId   String
  reason     String
  status     String   @default("pending") // 'pending', 'resolved', 'dismissed'
  createdAt  DateTime @default(now())

  reporter User?  @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("reports")
}
